<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Margin="0,4,0,4">

    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="340"/>
        <ColumnDefinition Width="3*"/>
        <ColumnDefinition Width="40"/>
    </Grid.ColumnDefinitions>

    <!-- Name (top-aligned so it stays put when nested chips wrap) -->
    <StackPanel Grid.Column="0"
                Margin="0,3,12,0"
                VerticalAlignment="Top">
        <TextBox x:Name="tb_Name"/>
        <!-- Inline validation message: name clash, missing name/children/URL/script, etc. -->
        <TextBlock x:Name="tb_NameError"
                   Text="Button Name Already Exists&#x2026;"
                   Foreground="{DynamicResource RemoveBrush}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Margin="2,3,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>
    </StackPanel>

    <!-- Type badges (radio-style). Order: single buttons, then containers -->
    <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Top"
                Margin="0,6,12,0">
        <Border x:Name="badge_PushButton" Style="{DynamicResource BadgeUnselected}">
            <Border.ToolTip>
                <ToolTip MaxWidth="270" Placement="Bottom">
                    <StackPanel>
                        <TextBlock Text="PushButton" Style="{DynamicResource TooltipTitleStyle}"/>
                        <TextBlock Style="{DynamicResource TooltipBodyStyle}"
                                   Text="Tombol paling umum di pyRevit. Satu tombol menjalankan satu script saat diklik. Contoh: tombol 'Hitung Luas' yang menjalankan satu perintah."/>
                        <Border Style="{DynamicResource TooltipStripStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{DynamicResource TooltipChipDimStyle}">
                                    <TextBlock Text="BTN A" Style="{DynamicResource TooltipChipLabelStyle}"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </Border>
                                <Border Style="{DynamicResource TooltipChipDimStyle}">
                                    <TextBlock Text="BTN B" Style="{DynamicResource TooltipChipLabelStyle}"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </Border>
                                <Border Style="{DynamicResource TooltipChipHotStyle}">
                                    <TextBlock Text="Tombol" Style="{DynamicResource TooltipChipLabelStyle}" Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{DynamicResource TooltipFooterStyle}"
                                   Text="Kapan memakai: Untuk satu perintah sederhana. Folder tombol berakhiran .pushbutton."/>
                    </StackPanel>
                </ToolTip>
            </Border.ToolTip>
            <TextBlock x:Name="lbl_PushButton" Text="PushButton" Style="{DynamicResource BadgeTextUnselected}"/>
        </Border>
        <Border x:Name="badge_Script"      Style="{DynamicResource BadgeUnselected}">
            <Border.ToolTip>
                <ToolTip MaxWidth="270" Placement="Bottom">
                    <StackPanel>
                        <TextBlock Text="From Script" Style="{DynamicResource TooltipTitleStyle}"/>
                        <TextBlock Style="{DynamicResource TooltipBodyStyle}"
                                   Text="Membuat PushButton baru langsung dari file script.py yang sudah ada - biasanya script yang dibagikan oleh PrasKaa. Kamu tidak perlu menulis kode sama sekali."/>
                        <Border Style="{DynamicResource TooltipStripStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{DynamicResource TooltipChipDimStyle}" Width="72">
                                    <TextBlock Text="script.py" Style="{DynamicResource TooltipChipLabelStyle}"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </Border>
                                <Path Data="M0,0 L7,0 L3.5,6 Z" Fill="{DynamicResource TextSecondaryBrush}"
                                      VerticalAlignment="Center" Margin="4,0,4,0"/>
                                <Border Style="{DynamicResource TooltipChipHotStyle}">
                                    <TextBlock Text="Tombol" Style="{DynamicResource TooltipChipLabelStyle}" Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{DynamicResource TooltipFooterStyle}"
                                   Text="Kapan memakai: Gunakan saat menerima file script.py dari orang lain."/>
                    </StackPanel>
                </ToolTip>
            </Border.ToolTip>
            <TextBlock x:Name="lbl_Script"      Text="From Script"  Style="{DynamicResource BadgeTextUnselected}"/>
        </Border>
        <Border x:Name="badge_URLButton"  Style="{DynamicResource BadgeUnselected}">
            <Border.ToolTip>
                <ToolTip MaxWidth="270" Placement="Bottom">
                    <StackPanel>
                        <TextBlock Text="URLButton" Style="{DynamicResource TooltipTitleStyle}"/>
                        <TextBlock Style="{DynamicResource TooltipBodyStyle}"
                                   Text="Tombol yang membuka website saat diklik, bukan menjalankan script. Berguna untuk tautan ke panduan, template, atau situs."/>
                        <Border Style="{DynamicResource TooltipStripStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{DynamicResource TooltipChipHotStyle}">
                                        <TextBlock Text="Buka Web" Style="{DynamicResource TooltipChipLabelStyle}" Foreground="White"/>
                                    </Border>
                                    <Path Data="M0,0 L7,0 L3.5,6 Z" Fill="{DynamicResource TextSecondaryBrush}"
                                          VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                                <Border MaxWidth="150" HorizontalAlignment="Left" Margin="0,4,0,0"
                                        CornerRadius="2" Padding="0"
                                        Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource HairlineBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <Border Height="5" Background="{DynamicResource HairlineBrush}"/>
                                        <TextBlock Text="https://..." FontSize="9" Margin="4,2,4,3"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{DynamicResource TooltipFooterStyle}"
                                   Text="Kapan memakai: Untuk tautan web. Wajib mengisi kolom URL."/>
                    </StackPanel>
                </ToolTip>
            </Border.ToolTip>
            <TextBlock x:Name="lbl_URLButton"  Text="URLButton"  Style="{DynamicResource BadgeTextUnselected}"/>
        </Border>
        <Border x:Name="badge_Stack"      Style="{DynamicResource BadgeUnselected}">
            <Border.ToolTip>
                <ToolTip MaxWidth="270" Placement="Bottom">
                    <StackPanel>
                        <TextBlock Text="Stack" Style="{DynamicResource TooltipTitleStyle}"/>
                        <TextBlock Style="{DynamicResource TooltipBodyStyle}"
                                   Text="Sekelompok tombol yang berjajar dalam satu tempat. Maksimal 3 item dan boleh campuran PushButton dan Pulldown."/>
                        <Border Style="{DynamicResource TooltipStripStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="120" Height="22" CornerRadius="3"
                                            Background="{DynamicResource ChipBgBrush}">
                                        <TextBlock Text="Menu" FontSize="9" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ChipTextBrush}"/>
                                    </Border>
                                    <Path Data="M0,0 L7,0 L3.5,5 Z" Fill="{DynamicResource TextSecondaryBrush}"
                                          VerticalAlignment="Center" Margin="3,0,0,0"/>
                                </StackPanel>
                                <Border Width="120" Height="22" CornerRadius="3" Margin="0,3,0,0"
                                        Background="{DynamicResource ChipBgBrush}">
                                    <TextBlock Text="PushButton" FontSize="9" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource ChipTextBrush}"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,0">
                                    <Border Width="120" Height="22" CornerRadius="3"
                                            Background="{DynamicResource ChipBgBrush}">
                                        <TextBlock Text="Menu" FontSize="9" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ChipTextBrush}"/>
                                    </Border>
                                    <Path Data="M0,0 L7,0 L3.5,5 Z" Fill="{DynamicResource TextSecondaryBrush}"
                                          VerticalAlignment="Center" Margin="3,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{DynamicResource TooltipFooterStyle}"
                                   Text="Kapan memakai: Untuk 2-3 perintah yang berdekatan, misal tiga cara ekspor. Maksimal 3 item - bisa PushButton, Pulldown, atau campuran."/>
                    </StackPanel>
                </ToolTip>
            </Border.ToolTip>
            <TextBlock x:Name="lbl_Stack"      Text="Stack"      Style="{DynamicResource BadgeTextUnselected}"/>
        </Border>
        <Border x:Name="badge_Pulldown"   Style="{DynamicResource BadgeUnselected}">
            <Border.ToolTip>
                <ToolTip MaxWidth="270" Placement="Bottom">
                    <StackPanel>
                        <TextBlock Text="Pulldown" Style="{DynamicResource TooltipTitleStyle}"/>
                        <TextBlock Style="{DynamicResource TooltipBodyStyle}"
                                   Text="Satu tombol yang, saat diklik, membuka daftar berisi banyak PushButton ke bawah. Cocok untuk banyak perintah dalam satu grup."/>
                        <Border Style="{DynamicResource TooltipStripStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{DynamicResource TooltipChipHotStyle}">
                                        <TextBlock Text="Menu" Style="{DynamicResource TooltipChipLabelStyle}" Foreground="White"/>
                                    </Border>
                                    <Path Data="M0,0 L7,0 L3.5,5 Z" Fill="{DynamicResource TextSecondaryBrush}"
                                          VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                                <Border MaxWidth="170" HorizontalAlignment="Left" Margin="0,4,0,0"
                                        CornerRadius="2"
                                        Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource HairlineBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="PushButton 1" FontSize="9" Margin="6,2,6,1"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="PushButton 2" FontSize="9" Margin="6,1,6,1"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="PushButton 3" FontSize="9" Margin="6,1,6,1"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="&#8230; hingga 10" FontSize="9" Margin="6,1,6,2"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{DynamicResource TooltipFooterStyle}"
                                   Text="Kapan memakai: Untuk banyak perintah dalam satu grup, misal 'Buat View'. Bisa berisi hingga 10 PushButton."/>
                    </StackPanel>
                </ToolTip>
            </Border.ToolTip>
            <TextBlock x:Name="lbl_Pulldown"   Text="Pulldown"   Style="{DynamicResource BadgeTextUnselected}"/>
        </Border>
    </StackPanel>

    <!-- Nested area: chips OR url OR script-picker, exactly one visible -->
    <Grid Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Top">

        <!-- Chips mode (Pulldown / Stack) -->
        <WrapPanel x:Name="chipWrap" VerticalAlignment="Top">
            <Grid x:Name="chipInputBox">
                <TextBox x:Name="tb_ChipInput" Style="{DynamicResource ChipInputStyle}"/>
                <TextBlock Text="',' to confirm"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=tb_ChipInput, Path=Text}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </WrapPanel>

        <!-- URL mode (URLButton) -->
        <Grid x:Name="urlArea" Visibility="Collapsed" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource UrlBadgeStyle}">
                <TextBlock Text="URL"
                           Foreground="{DynamicResource ChipTextBrush}"
                           FontWeight="SemiBold"
                           FontSize="11"/>
            </Border>

            <Grid Grid.Column="1" Margin="6,0,0,0">
                <TextBox x:Name="tb_Url"/>
                <TextBlock Text="https://..."
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=tb_Url, Path=Text}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- Script mode (import an existing script.py via file dialog) -->
        <Grid x:Name="scriptArea" Visibility="Collapsed" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="btn_BrowseScript"
                    Content="Browse script.py&#x2026;"
                    ToolTip="Pilih file script.py dari PrasKaa untuk dijadikan tombol."
                    Style="{DynamicResource SecondaryOutlineButtonStyle}"/>

            <TextBlock Grid.Column="1"
                       x:Name="tb_ScriptPath"
                       Text="No file selected"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextMutedBrush}"/>
        </Grid>
    </Grid>

    <!-- Row remove (red X) -->
    <Button x:Name="btn_Remove"
            Grid.Column="3"
            Style="{DynamicResource RowRemoveStyle}"
            VerticalAlignment="Top"
            Margin="0,3,0,0"/>
</Grid>
