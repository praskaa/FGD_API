<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PrasKaa Buttons Generator"
        Width="980" Height="660"
        MinWidth="760" MinHeight="420"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="White"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">


    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome ResizeBorderThickness="8"
                            CaptionHeight="0"
                            GlassFrameThickness="0,0,0,1"
                            CornerRadius="3"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- ============================================================ -->
        <!--  COLORS — PrasKaa palette (pyrevit-wpf skill default, light)  -->
        <!-- ============================================================ -->
        <SolidColorBrush x:Key="BgBrush"                     Color="#F2EDDC"/>
        <SolidColorBrush x:Key="PanelBrush"                  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush"                 Color="#0C4A63"/>
        <SolidColorBrush x:Key="AccentHoverBrush"            Color="#0A3F55"/>
        <SolidColorBrush x:Key="ContainerSelectedBrush"      Color="#B45252"/>
        <SolidColorBrush x:Key="ContainerSelectedHoverBrush" Color="#8F3F3F"/>
        <SolidColorBrush x:Key="RemoveBrush"                 Color="#B4433C"/>
        <SolidColorBrush x:Key="RemoveSoftBgBrush"           Color="#F6DEDC"/>
        <SolidColorBrush x:Key="HairlineBrush"               Color="#D8D2BE"/>
        <SolidColorBrush x:Key="HairlineHoverBrush"          Color="#C6BFA6"/>
        <SolidColorBrush x:Key="WindowBorderBrush"           Color="#D8D2BE"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"            Color="#0C3A52"/>
        <SolidColorBrush x:Key="TextSecondaryBrush"          Color="#6E93A0"/>
        <SolidColorBrush x:Key="TextMutedBrush"              Color="#9AA7AC"/>
        <SolidColorBrush x:Key="BadgeBgBrush"                Color="#E8E2CF"/>
        <SolidColorBrush x:Key="BadgeHoverBgBrush"           Color="#DED6BE"/>
        <SolidColorBrush x:Key="BadgeBorderBrush"            Color="#D8D2BE"/>
        <SolidColorBrush x:Key="BadgeTextBrush"              Color="#0C3A52"/>
        <SolidColorBrush x:Key="ChipBgBrush"                 Color="#D9E3E6"/>
        <SolidColorBrush x:Key="ChipBorderBrush"             Color="#B9CDD3"/>
        <SolidColorBrush x:Key="ChipTextBrush"               Color="#0C4A63"/>

        <!-- ============================================================ -->
        <!--  DEFAULT FONT (Segoe UI, matches Revit's own UI)              -->
        <!-- ============================================================ -->
        <Style TargetType="{x:Type Control}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="12"/>
        </Style>

        <!-- ============================================================ -->
        <!--  DEFAULT STYLES                                              -->
        <!-- ============================================================ -->
        <Style TargetType="TextBox">
            <Setter Property="Padding"                  Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush"               Value="{DynamicResource HairlineBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Background"               Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground"                Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize"                 Value="13"/>
        </Style>

        <Style x:Key="FlatButtonBase" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonBase}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding"    Value="20,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonBase}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding"    Value="14,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BadgeHoverBgBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Outline variant used for the "Browse script.py…" button -->
        <Style x:Key="SecondaryOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonBase}">
            <Setter Property="Foreground"      Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================ -->
        <!--  Title-bar close button                                      -->
        <!-- ============================================================ -->
        <Style x:Key="TitleCloseStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonBase}">
            <Setter Property="Content"    Value="&#x2715;"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Width"      Value="36"/>
            <Setter Property="Height"     Value="32"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="Padding"    Value="0"/>
            <Setter Property="ToolTip"    Value="Close"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RemoveSoftBgBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource RemoveBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================ -->
        <!--  Badges (rounded rectangles, smaller font)                   -->
        <!-- ============================================================ -->
        <Style x:Key="BadgeUnselected" TargetType="Border">
            <Setter Property="CornerRadius"    Value="3"/>
            <Setter Property="Padding"         Value="7,4,7,4"/>
            <Setter Property="Margin"          Value="0,0,5,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Background"      Value="{DynamicResource BadgeBgBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BadgeBorderBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="{DynamicResource BadgeHoverBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource HairlineHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BadgeSelectedSingle" TargetType="Border" BasedOn="{StaticResource BadgeUnselected}">
            <Setter Property="Background"  Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="{DynamicResource AccentHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BadgeSelectedContainer" TargetType="Border" BasedOn="{StaticResource BadgeUnselected}">
            <Setter Property="Background"  Value="{DynamicResource ContainerSelectedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ContainerSelectedBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="{DynamicResource ContainerSelectedHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ContainerSelectedHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BadgeTextUnselected" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource BadgeTextBrush}"/>
        </Style>
        <Style x:Key="BadgeTextSelected" TargetType="TextBlock" BasedOn="{StaticResource BadgeTextUnselected}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ============================================================ -->
        <!--  Chips (rounded rectangles)                                  -->
        <!-- ============================================================ -->
        <Style x:Key="ChipBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius"    Value="3"/>
            <Setter Property="Background"      Value="{DynamicResource ChipBgBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ChipBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,2,4,2"/>
            <Setter Property="Margin"          Value="0,3,4,3"/>
        </Style>

        <Style x:Key="ChipTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground"        Value="{DynamicResource ChipTextBrush}"/>
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Margin"            Value="0,0,4,0"/>
        </Style>

        <Style x:Key="ChipRemoveStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonBase}">
            <Setter Property="Content"    Value="&#x2715;"/>
            <Setter Property="Foreground" Value="{DynamicResource RemoveBrush}"/>
            <Setter Property="Padding"    Value="4,0,4,0"/>
            <Setter Property="FontSize"   Value="11"/>
        </Style>

        <Style x:Key="ChipInputStyle" TargetType="TextBox">
            <Setter Property="MinWidth"                 Value="110"/>
            <Setter Property="Margin"                   Value="0,3,0,3"/>
            <Setter Property="Padding"                  Value="6,4"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="BorderBrush"               Value="{DynamicResource HairlineBrush}"/>
            <Setter Property="Background"               Value="{DynamicResource PanelBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize"                 Value="12"/>
        </Style>

        <!-- ============================================================ -->
        <!--  URL prefix badge                                            -->
        <!-- ============================================================ -->
        <Style x:Key="UrlBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius"      Value="3"/>
            <Setter Property="Background"        Value="{DynamicResource ChipBgBrush}"/>
            <Setter Property="BorderBrush"       Value="{DynamicResource ChipBorderBrush}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="10,3,10,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============================================================ -->
        <!--  Row remove                                                  -->
        <!-- ============================================================ -->
        <Style x:Key="RowRemoveStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonBase}">
            <Setter Property="Content"           Value="&#x2715;"/>
            <Setter Property="Foreground"        Value="{DynamicResource RemoveBrush}"/>
            <Setter Property="FontSize"          Value="16"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Padding"           Value="6,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip"           Value="Remove this row"/>
        </Style>

        <Style x:Key="ColumnHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin"     Value="2,0"/>
        </Style>

        <!-- ============================================================ -->
        <!--  Thin flat scrollbar (matches pyrevit-wpf standard)          -->
        <!-- ============================================================ -->
        <Style x:Key="ThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource HairlineHoverBrush}" CornerRadius="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width"  Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Width="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Width="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThumbStyle}" Width="8"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    
    
    <Border Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="3">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============== Title bar (icon + title + close) ============== -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BgBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}"
                    BorderThickness="0,0,0,1">
                <Grid x:Name="titleBar" Background="Transparent" Height="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           x:Name="img_TitleIcon"
                           Width="26" Height="26"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="PrasKaa Buttons Generator"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>

                    <Button Grid.Column="2"
                            x:Name="btn_Close"
                            Style="{StaticResource TitleCloseStyle}"
                            Margin="0,0,8,0"/>
                </Grid>
            </Border>

            <!-- ============== Content ============== -->
            <Grid Grid.Row="1" Margin="20,4,20,12" Background="{DynamicResource PanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Subheading + Target panel selector -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Create new pyRevit Buttons, Stacks, Pulldown menus, or import an existing script.py."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               FontSize="12"/>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <TextBlock Text="Target panel:"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Margin="0,0,6,0"/>
                        <ComboBox x:Name="cb_Panel"
                                  MinWidth="160"
                                  FontSize="12"
                                  Padding="6,2"/>
                    </StackPanel>
                </Grid>

                <!-- Column headers -->
                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="NAME"               Style="{StaticResource ColumnHeaderStyle}"/>
                    <TextBlock Grid.Column="1" Text="TYPE"               Style="{StaticResource ColumnHeaderStyle}"/>
                    <TextBlock Grid.Column="2" Text="NESTED PUSHBUTTONS / URL / SCRIPT" Style="{StaticResource ColumnHeaderStyle}"/>
                </Grid>

                <!-- Rows -->
                <Border Grid.Row="2"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource HairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="sp_Rows"/>
                    </ScrollViewer>
                </Border>

                <!-- Footer buttons -->
                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btn_AddRow"
                                Content="+ Add Row"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                        <TextBlock Text="or press Ctrl+Enter to add a row"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   FontSize="12"/>
                    </StackPanel>

                    <!-- Inline status for form-level issues (replaces pop-ups) -->
                    <TextBlock Grid.Column="1"
                               x:Name="tb_GlobalError"
                               Foreground="{DynamicResource RemoveBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               TextWrapping="Wrap"
                               Margin="16,0,12,0"
                               Visibility="Collapsed"/>

                    <Button Grid.Column="2"
                            x:Name="btn_Cancel"
                            Content="Cancel"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"/>
                    <Button Grid.Column="3"
                            x:Name="btn_Create"
                            Content="Create"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid>

                <!-- Credit footer -->
                <TextBlock Grid.Row="4"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="Made by PrasKaa"/>
            </Grid>
        </Grid>
    </Border>
</Window>
