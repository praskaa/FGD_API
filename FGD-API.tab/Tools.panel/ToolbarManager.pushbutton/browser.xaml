<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="pyRevit Toolbar Manager"
        Width="766" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome ResizeBorderThickness="0"
                            CaptionHeight="0"
                            GlassFrameThickness="0,0,0,1"
                            CornerRadius="8"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- ============== Brushes (overwritten wholesale on theme toggle) ============== -->
        <SolidColorBrush x:Key="BgBrush"           Color="#F2EDDC"/>
        <SolidColorBrush x:Key="PanelBrush"         Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush1"       Color="#D8D2BE"/>
        <SolidColorBrush x:Key="TextBrush"          Color="#0C3A52"/>
        <SolidColorBrush x:Key="SubTextBrush"       Color="#6E93A0"/>
        <SolidColorBrush x:Key="AccentBrush"        Color="#0C4A63"/>
        <SolidColorBrush x:Key="AccentTextBrush"    Color="#F2ECDC"/>
        <SolidColorBrush x:Key="OnLightBrush"       Color="#0C3A52"/>
        <SolidColorBrush x:Key="SelectedBrush"      Color="#D9E3E6"/>
        <SolidColorBrush x:Key="HeaderBrush"        Color="#E8E2CF"/>
        <SolidColorBrush x:Key="RemoveBrush"        Color="#EF4444"/>
        <SolidColorBrush x:Key="RemoveSoftBgBrush"  Color="#FEE2E2"/>

        <!-- ============== Base control font ============== -->
        <Style TargetType="{x:Type Control}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="12"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding"                  Value="8,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background"               Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground"                Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource BorderBrush1}"/>
            <Setter Property="BorderThickness"          Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding"    Value="6,4"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style x:Key="FlatButtonBase" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonBase}">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Background" Value="{DynamicResource HeaderBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonBase}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding"    Value="16,8"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonBase}">
            <Setter Property="Background" Value="{DynamicResource RemoveSoftBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource RemoveBrush}"/>
            <Setter Property="Padding"    Value="12,7"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============== "Add New" type badges ============== -->
        <Style x:Key="NewBadgeUnselected" TargetType="Border">
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="8,5,8,5"/>
            <Setter Property="Margin"          Value="0,0,6,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Background"      Value="{DynamicResource HeaderBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush1}"/>
        </Style>
        <Style x:Key="NewBadgeSelected" TargetType="Border" BasedOn="{StaticResource NewBadgeUnselected}">
            <Setter Property="Background"  Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style x:Key="NewBadgeTextUnselected" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style x:Key="NewBadgeTextSelected" TargetType="TextBlock" BasedOn="{StaticResource NewBadgeTextUnselected}">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="TitleCloseStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonBase}">
            <Setter Property="Content"    Value="&#x2715;"/>
            <Setter Property="Width"      Value="36"/>
            <Setter Property="Height"     Value="32"/>
            <Setter Property="Padding"    Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RemoveSoftBgBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource RemoveBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============== Flat scrollbar ============== -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource BorderBrush1}" CornerRadius="4" Margin="1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============== TreeView theming ============== -->
        <Style TargetType="TreeView">
            <Setter Property="Background"      Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding"    Value="2,5"/>
        </Style>

    </Window.Resources>

    <Border Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush1}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============== Title bar ============== -->
            <Border Grid.Row="0" x:Name="titleBar"
                    BorderBrush="{DynamicResource BorderBrush1}"
                    BorderThickness="0,0,0,1"
                    Background="{DynamicResource HeaderBrush}"
                    CornerRadius="8,8,0,0">
                <Grid Height="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="pyRevit Toolbar Manager"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>

                    <CheckBox Grid.Column="2" x:Name="cb_AlwaysOnTop"
                              Content="Always on top"
                              Foreground="{DynamicResource SubTextBrush}"
                              FontSize="11"
                              VerticalAlignment="Center"
                              Margin="0,0,14,0"/>

                    <Button Grid.Column="3" x:Name="btn_ThemeToggle"
                            Content="&#x25D0;"
                            Style="{StaticResource FlatButtonBase}"
                            Width="32" Height="32"
                            ToolTip="Toggle dark/light"
                            Margin="0,0,4,0"/>

                    <Button Grid.Column="4" x:Name="btn_Close"
                            Style="{StaticResource TitleCloseStyle}"
                            Margin="0,0,6,0"/>
                </Grid>
            </Border>

            <!-- ============== Content ============== -->
            <Grid Grid.Row="1" Margin="16,12,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Left: search + tree -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBox x:Name="tb_Search" FontSize="13" Padding="10,9"/>
                        <TextBlock Text="Search buttons, panels, tabs..."
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource SubTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=tb_Search, Path=Text}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Border Grid.Row="2"
                            BorderBrush="{DynamicResource BorderBrush1}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4"
                            Height="600"
                            VerticalAlignment="Top">
                        <TreeView x:Name="tv_Tree"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </Grid>

                <!-- Right: selected-item actions -->
                <Border Grid.Column="2"
                        BorderBrush="{DynamicResource BorderBrush1}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Height="648"
                        VerticalAlignment="Top">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="SELECTED ITEM"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SubTextBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="tb_SelectedPath"
                                   Text="Nothing selected"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,0,0,10"/>

                        <Button x:Name="btn_OpenExplorer" Content="&#x1F4C2; Open in Explorer"
                                Style="{StaticResource ToolButtonStyle}"
                                HorizontalAlignment="Stretch"
                                IsEnabled="False"
                                Margin="0,0,0,14"/>

                        <!-- ================= ADD NEW (contextual) ================= -->
                        <StackPanel x:Name="sp_AddNewSection" Visibility="Collapsed" Margin="0,0,0,16">
                            <TextBlock x:Name="tb_AddNewHeader" Text="ADD NEW"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>

                            <!-- Type picker: only shown when the selected item allows more than one child kind -->
                            <WrapPanel x:Name="wp_NewTypeBadges" Visibility="Collapsed" Margin="0,0,0,4">
                                <Border x:Name="badge_New_PushButton" Style="{DynamicResource NewBadgeUnselected}">
                                    <TextBlock x:Name="lbl_New_PushButton" Text="PushButton" Style="{DynamicResource NewBadgeTextUnselected}"/>
                                </Border>
                                <Border x:Name="badge_New_URLButton" Style="{DynamicResource NewBadgeUnselected}">
                                    <TextBlock x:Name="lbl_New_URLButton" Text="URLButton" Style="{DynamicResource NewBadgeTextUnselected}"/>
                                </Border>
                                <Border x:Name="badge_New_Stack" Style="{DynamicResource NewBadgeUnselected}">
                                    <TextBlock x:Name="lbl_New_Stack" Text="Stack" Style="{DynamicResource NewBadgeTextUnselected}"/>
                                </Border>
                                <Border x:Name="badge_New_Pulldown" Style="{DynamicResource NewBadgeUnselected}">
                                    <TextBlock x:Name="lbl_New_Pulldown" Text="Pulldown" Style="{DynamicResource NewBadgeTextUnselected}"/>
                                </Border>
                            </WrapPanel>

                            <TextBox x:Name="tb_NewName" Margin="0,0,0,6"/>

                            <!-- URL field: only shown once URLButton is the chosen type -->
                            <TextBox x:Name="tb_NewUrl" Visibility="Collapsed" Margin="0,0,0,6"/>
                            <TextBlock x:Name="tb_NewUrlHint" Text="https://..."
                                       Visibility="Collapsed"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       FontSize="11" Margin="0,-10,0,6"/>

                            <TextBlock x:Name="tb_AddNewError"
                                       Foreground="{DynamicResource RemoveBrush}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Visibility="Collapsed" Margin="0,0,0,6"/>

                            <Button x:Name="btn_CreateNew" Content="Create"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <Separator x:Name="sep_AddNew" Visibility="Collapsed" Margin="0,0,0,16"/>

                        <!-- ================= Existing item actions ================= -->
                        <StackPanel x:Name="sp_ExistingActions">
                            <TextBlock Text="RENAME" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="tb_RenameInput" Margin="0,0,0,6"/>
                            <Button x:Name="btn_Rename" Content="Rename"
                                    Style="{StaticResource ToolButtonStyle}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,14"/>

                            <TextBlock Text="REORDER" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="btn_MoveUp" Content="&#x2191; Up"
                                        Style="{StaticResource ToolButtonStyle}" Margin="0,0,8,0"/>
                                <Button x:Name="btn_MoveDown" Content="&#x2193; Down"
                                        Style="{StaticResource ToolButtonStyle}"/>
                            </StackPanel>
                            <CheckBox x:Name="cb_Slideout"
                                      Content="Put in panel's slide-out (overflow)"
                                      Foreground="{DynamicResource TextBrush}"
                                      FontSize="11"
                                      IsEnabled="False"
                                      ToolTip="Temporarily disabled — this was messing up existing layouts."
                                      Margin="0,0,0,14"/>

                            <TextBlock Text="MOVE TO PANEL / TAB" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cb_MoveTarget" Margin="0,0,0,6"/>
                            <Button x:Name="btn_MoveTo" Content="Move Here"
                                    Style="{StaticResource ToolButtonStyle}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,14"/>

                            <Separator Margin="0,0,0,14"/>

                            <Button x:Name="btn_Delete" Content="Delete Permanently"
                                    Style="{StaticResource DangerButtonStyle}"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ============== Footer ============== -->
            <Grid Grid.Row="2" Margin="16,12,16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="btn_Refresh" Content="Refresh"
                        Style="{StaticResource ToolButtonStyle}" Margin="0,0,8,0"/>

                <Button Grid.Column="1" x:Name="btn_Diagnose" Content="Diagnose"
                        Style="{StaticResource ToolButtonStyle}"
                        ToolTip="Scan every bundle.yaml in this extension for known pyRevit-breaking issues"/>

                <TextBlock Grid.Column="2" x:Name="tb_Status"
                           Foreground="{DynamicResource SubTextBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Margin="14,0,0,0"
                           FontSize="12"/>

                <Button Grid.Column="3" x:Name="btn_ReloadPyrevit" Content="Reload pyRevit"
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
